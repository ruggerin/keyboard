/*
 * Migrated from Vial/QMK layout (layout_antigo.vil)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

#define BASE   0
#define LOWER  1
#define RAISE  2
#define ADJUST 3

/ {

    // Holding LOWER + RAISE together activates ADJUST (same trick the old
    // FN_MO13 / FN_MO23 keycodes did in the QMK/Vial firmware).
    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    macros {
        arrow_mac: arrow_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp MINUS &kp GT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "base";
// ------------------------------------------------------------------------------------------------------------------------
// |  Esc  |  1  |  2  |  3  |  4  |  5  |                                |  6  |  7  |  8  |  9  |  0  |   -    |
// |  Tab  |  Q  |  W  |  E  |  R  |  T  |                                |  Y  |  U  |  I  |  O  |  P  |   =    |
// | Caps  |  A  |  S  |  D  |  F  |  G  |                                |  H  |  J  |  K  |  L  |  [  |  Bksp  |
// | Shift |  Z  |  X  |  C  |  V  |  B  | Mute |            | TG(LOWER) | |  N  |  M  |  ,  |  .  | RO  | Shift  |
//              | Ctrl | Gui | Alt | LOWER | Space |          | Space | RAISE | Ctrl | Alt | Del |
            bindings = <
&kp ESC    &kp N1   &kp N2   &kp N3   &kp N4   &kp N5                                    &kp N6   &kp N7   &kp N8    &kp N9   &kp N0   &kp MINUS
&kp TAB    &kp Q    &kp W    &kp E    &kp R    &kp T                                     &kp Y    &kp U    &kp I     &kp O    &kp P    &kp EQUAL
&kp CAPS   &kp A    &kp S    &kp D    &kp F    &kp G                                     &kp H    &kp J    &kp K     &kp L    &kp LBKT &kp BSPC
&kp LSHFT  &kp Z    &kp X    &kp C    &kp V    &kp B    &kp C_MUTE   &tog LOWER          &kp N    &kp M    &kp COMMA &kp DOT  &kp INT1 &kp RSHFT
                    &kp LCTRL &kp LGUI &kp LALT &mo LOWER &kp SPACE   &kp SPACE &mo RAISE &kp RCTRL &kp RALT &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp DOWN UP>;
        };

        lower_layer {
            display-name = "lower";
// ------------------------------------------------------------------------------------------------------------------------
// |   `   |  1  |  2  |  3  |  4  |  5  |                                | Num |  7  |  8  |  9  |  =  |  KP+   |
// |  Esc  |  Q  |  Up  |  F  |  P  | F5  |                                | KP7 | KP8 | KP9 | Ins | Bksp|   }    |
// | Caps  | Left| Down |Right|  ]  |  \  |                                | KP4 | KP5 | KP6 |  ;  |  '  |   |    |
// | Shift | RO  |  X   |  C  |  }  |  |  | Mute |            | TG(LOWER) | | KP1 | KP2 | KP3 |  /  |  /  | Shift  |
//              | Gui  | Alt | Alt | Enter | Enter  |          | KP0   | Enter | ,  |  .  | Enter |
            bindings = <
&kp GRAVE  &kp N1   &kp N2   &kp N3   &kp N4   &kp N5                                    &kp KP_NUM &kp N7    &kp N8    &kp MINUS &kp EQUAL &kp KP_PLUS
&kp ESC    &kp Q    &kp UP   &kp F    &kp P    &kp F5                                    &kp KP_N7  &kp KP_N8 &kp KP_N9 &kp LS(INSERT) &kp BSPC &kp RBRC
&kp CAPS   &kp LEFT &kp DOWN &kp RIGHT &kp RBKT &kp BSLH                                 &kp KP_N4  &kp KP_N5 &kp KP_N6 &kp SEMI  &kp SQT   &kp PIPE
&kp LSHFT  &kp NUBS &kp X    &kp C    &kp RBRC &kp PIPE &kp C_MUTE  &tog LOWER           &kp KP_N1  &kp KP_N2 &kp KP_N3 &kp FSLH  &kp FSLH  &kp RSHFT
                    &kp LGUI &kp LALT &kp LALT &kp RET  &kp RET     &kp KP_N0 &kp RET    &kp COMMA  &kp DOT   &kp RET
            >;

            sensor-bindings = <&inc_dec_kp RIGHT LEFT &inc_dec_kp PG_DN PG_UP>;
        };

        raise_layer {
            display-name = "raise";
// ------------------------------------------------------------------------------------------------------------------------
// |   `   | F1  | F2  | F3  | F4  | F5  |                                | F6  | F7  | F8  | F9  | F10 |   F11  |
// |   `   |  1  |  Up |  #  |  $  |  %  |                                |  ^  |Home |PgUp | "->"|Bksp |   F12  |
// | Caps  | Left| Down|Right|  ]  |  \  |                                |  ^  | End |PgDn |  (  |  "  |   Del  |
// | Shift | RO  |  -  |  +  |  }  |  |  |C_NEXT|            |  to(BASE) | |  [  |  ]  |  ?  |  ]  | ?RO |  Shift |
//              | Ctrl | Gui | Alt | KP0 | trans  |          | Enter | trans | ?RO | ?  | trans |
            bindings = <
&kp GRAVE  &kp F1   &kp F2   &kp F3   &kp F4   &kp F5                                    &kp F6     &kp F7    &kp F8      &kp F9     &kp F10  &kp F11
&kp GRAVE  &kp N1   &kp UP   &kp HASH &kp DLLR &kp PRCNT                                 &kp CARET  &kp HOME  &kp PG_UP   &arrow_mac &kp BSPC &kp F12
&kp CAPS   &kp LEFT &kp DOWN &kp RIGHT &kp RBKT &kp BSLH                                 &kp CARET  &kp END   &kp PG_DN   &kp LPAR   &kp DQT  &kp DEL
&kp LSHFT  &kp NUBS &kp MINUS &kp PLUS &kp RBRC &kp PIPE &kp C_NEXT  &to BASE            &kp LBKT   &kp RBKT  &kp QUESTION &kp RBKT  &kp LS(INT1) &kp RSHFT
                    &kp LCTRL &kp LGUI &kp LALT &kp KP_N0 &trans     &kp RET   &trans    &kp LS(INT1) &kp QUESTION &trans
            >;

            sensor-bindings = <&trans &trans>;
        };

        adjust_layer {
            display-name = "adjust";
// ------------------------------------------------------------------------------------------------------------------------
// |  Esc  |trans| KP7 | KP8 | KP9 |trans|                                |trans|trans|trans|trans|trans|  trans |
// | trans |  !  |Bksp | KP9 | KP8 | KP7 |                                |  ^  |  &  |  *  |  (  |  )  |  Bksp  |
// | trans |  A  |  ,  | KP6 | KP5 | KP4 |                                |PgDn |Left |Down |Right| Del |  Bksp  |
// | trans |Undo |  .  | KP3 | KP2 | KP1 |trans |            | tog(BASE) | |none |trans|none |trans|none | trans  |
//              | trans| trans| trans | Enter | KP0    |          | Enter | RAISE | trans | trans | mo(BASE) |
            bindings = <
&kp ESC    &trans   &kp KP_N7 &kp KP_N8 &kp KP_N9 &trans                                 &trans     &trans    &trans    &trans    &trans   &trans
&trans     &kp EXCL &kp BSPC  &kp KP_N9 &kp KP_N8 &kp KP_N7                              &kp CARET  &kp AMPS  &kp ASTRK &kp LPAR  &kp RPAR &kp BSPC
&trans     &kp A    &kp COMMA &kp KP_N6 &kp KP_N5 &kp KP_N4                              &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT &kp DEL  &kp BSPC
&trans     &kp K_UNDO &kp DOT &kp KP_N3 &kp KP_N2 &kp KP_N1 &trans    &tog BASE          &none      &trans    &none     &trans    &none    &trans
                    &trans   &trans    &trans    &kp RET   &kp KP_N0  &kp RET  &mo RAISE &trans     &trans    &mo BASE
            >;

            sensor-bindings = <&trans &trans>;
        };

    };
};
